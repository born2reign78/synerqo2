// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Core system models for modular Odoo-like system

model Module {
  id           String   @id @default(cuid())
  name         String   @unique
  version      String
  description  String?
  author       String?
  installed    Boolean  @default(false)
  autoInstall  Boolean  @default(false)
  dependencies String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menus  Menu[]
  views  View[]
  models ModelDefinition[]
}

model Menu {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  parent    Menu?    @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  Menu[]   @relation("MenuHierarchy")
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  sequence  Int      @default(10)
  action    String?
  icon      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model View {
  id        String   @id @default(cuid())
  name      String
  type      String // form, tree, kanban, search, etc.
  model     String
  priority  Int      @default(16)
  inheritId String?
  arch      String   @db.Text // XML/JSON architecture
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModelDefinition {
  id          String   @id @default(cuid())
  name        String
  table       String
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  fields      Json // Field definitions
  relations   Json? // Relation definitions
  constraints Json? // Constraints
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IrModelData {
  id         String   @id @default(cuid())
  module     String
  name       String
  model      String
  resId      String?
  dateUpdate DateTime @default(now())

  @@unique([module, name, model])
}
